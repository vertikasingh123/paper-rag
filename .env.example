# Copy to .env and fill in ONE of these. Both providers have a free tier
# that does not require a credit card.

# --- Option A: Groq (default) -------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option B: Google Gemini --------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Force a provider. Leave blank to auto-detect from whichever key is set.
LLM_PROVIDER=

# Embeddings run locally on your machine - no key, no cost.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
